@page "/products"
@rendermode InteractiveServer

@using TechnovaSoulutions.Components.Service
@using TechnovaSoulutions.Components

@inject DatabaseService databaseService

<PageTitle>Produkte</PageTitle>

<h1>Produkte</h1>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Kategorie</th>
            <th>price</th>
            <th>Lagerbestand</th>
            <th>Lieferranten id</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in productsList)
        {
            <tr>
                <td>@product.product_id</td>
                <td>@product.name</td>
                <td>@product.category</td>
                <td>@product.price.ToString("0.00") €</td>
                <td>@product.stock_quantity</td>
                <td>@product.supplier_id</td>
            </tr>
        }
    </tbody>
</table>

@code {
    List<Product_Model> productsList = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();

        productsList = databaseService.GetAllProducts();
    }
}
